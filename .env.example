# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Multi-AI TTS Failover Keys (server-side only, never exposed to client):
# Additional Gemini API keys (used automatically when primary Gemini TTS quota is reached)
GEMINI_API_KEY_BACKUP=""
GEMINI_API_KEY_3=""
GEMINI_API_KEYS=""

# Google Cloud Text-to-Speech (Neural2 pt-BR fallback)
GOOGLE_TTS_API_KEY=""

# OpenAI Audio Speech (gpt-4o-mini-tts / tts-1 fallback)
OPENAI_API_KEY=""

# ElevenLabs Multilingual v2 fallback (optional custom voice IDs)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID_MALE=""
ELEVENLABS_VOICE_ID_FEMALE=""

# Admin Google account emails allowed to edit the Legal Knowledge Base (comma-separated)
ADMIN_EMAILS=""
